# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/

# Streamlit secrets (NEVER commit real passwords/keys)
.streamlit/secrets.toml

# Local scan cache (regenerated by scans; can grow large)
data/scans/*.json
!data/scans/.gitkeep

# Local data caches (fundamentals + per-ticker prices + social snapshots).
# All regenerable on the next scan; not worth versioning.
data/cache/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Word / Office lock files (created while a doc is open)
~$*


# Logs
*.log

# Diagnostic script outputs (the inspect_*.py scripts in tools/ write
# .txt dumps when run; the scripts themselves are committed, but their
# transient output isn't worth versioning)
*_diagnostic.txt
tools/*.txt

# Temp files from in-place edits (Python writes .tmp first then renames;
# occasionally one leaks if a process dies mid-write)
*.tmp

# Distribution / build artifacts
build/
dist/
*.egg-info/
data/journal.json
data/*.jsonl
data/scans/*.jsonl
Claude outputs/
